# MySQL (docker-compose)
MYSQL_DATABASE=hr_management
MYSQL_ROOT_PASSWORD=root

# Server (Spring Boot)
DB_URL=jdbc:mysql://localhost:3306/hr_management?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci
DB_USERNAME=root
DB_PASSWORD=root
SERVER_PORT=3001
JWT_SECRET=CHANGE_ME_run_openssl_rand_-hex_32
JWT_EXPIRATION=86400000
CORS_ORIGIN=http://localhost:5173

# Client (Vite, baked at build time)
VITE_API_URL=http://localhost:3001/api
